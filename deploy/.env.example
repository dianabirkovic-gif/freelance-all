# Production compose variables. Copy to `.env` next to docker-compose.prod.yml,
# fill in, `chmod 600 .env`, never commit it. No real secrets belong in this file.

# Public hostname Caddy serves and gets a TLS certificate for.
SITE_ADDRESS=app.example.com
# Exact origin of the site (scheme + host, no trailing slash). Same-origin
# deployments don't strictly need CORS, but the backend refuses to start in the
# prod profile without it.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Database. Generate the password: openssl rand -base64 24
DB_NAME=frilanceos
DB_USERNAME=frilanceos
DB_PASSWORD=

# Base64 HS256 key, >= 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=1440

# Frontend build-time API base. Relative = same origin through Caddy.
VITE_API_BASE_URL=/api/v1
